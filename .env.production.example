# Copy to .env only on the production server. Never commit the resulting .env.
DOMAIN=rulefinder.app
POSTGRES_USER=rulefinder
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rulefinder
DATABASE_URL=postgresql+asyncpg://rulefinder:replace-with-a-long-random-password@db:5432/rulefinder
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-a-minimum-3-character-access-key
S3_SECRET_KEY=replace-with-a-long-minio-secret
S3_BUCKET=rulefinder
S3_REGION=us-east-1
S3_USE_SSL=0

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
OPENAI_VECTOR_STORE_ID=
OPENAI_VECTOR_STORE_AUTO_SYNC=1
OPENAI_AGENT_NAME=RuleFinder Rules Agent
GPT5_MINI_MODEL=gpt-5-mini
GPT5_FULL_MODEL=gpt-5
EMBEDDINGS_MODEL=text-embedding-3-small

JWT_SECRET=replace-with-a-32-character-or-longer-random-secret
ACCESS_TOKEN_TTL_HOURS=72
PUBLIC_APP_URL=https://rulefinder.app
CORS_ORIGINS=https://rulefinder.app,https://www.rulefinder.app
SERVICE_PROVIDER_LEGAL_NAME=RuleFinder
SERVICE_PROVIDER_ADDRESS=
ADMIN_TAKEDOWN_EMAILS=
ADMIN_REVIEW_TOKEN=replace-with-a-long-random-admin-token
