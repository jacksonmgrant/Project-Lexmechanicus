# --- App ---
APP_ENV=dev
BASE_URL=http://localhost:4269
API_URL=http://localhost:8765
CORS_ORIGINS=http://localhost:4269


# --- DB ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexmechanicus
PGVECTOR_ENABLED=1
REDIS_URL=redis://localhost:6379/0


# --- Storage ---
S3_ENDPOINT=http://localhost:9190
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lexmechanicus
S3_REGION=us-east-1
S3_USE_SSL=0


# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
GPT5_MINI_MODEL=gpt-5-mini
GPT5_FULL_MODEL=gpt-5
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_AGENT_NAME="Lexmechanicus Rules Agent"
OPENAI_VECTOR_STORE_ID=
OPENAI_VECTOR_STORE_AUTO_SYNC=1


# --- Security ---
JWT_SECRET=replace-with-a-32-byte-or-longer-secret
JWT_EXPIRES_HOURS=72


# --- Ads ---
ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_SLOT_TOP=1234567890
ADSENSE_SLOT_INLINE=2345678901


# --- Feature flags ---
FEATURE_AUTO_ESCALATE=1 # set 0 to disable without code changes
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=1000
